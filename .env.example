# Copy to .env and fill in. The API, the Pi services and the Vite build all read this one file.

# --- Your game -------------------------------------------------------------
# MLB Stats API team id. Find yours at https://statsapi.mlb.com/api/v1/teams?sportId=1
# (113 = Cincinnati Reds.)
MLB_TEAM_ID=113
# The game to follow, YYYY-MM-DD. Leave blank to use today's date.
MLB_GAME_DATE=
# 1 skips MLB polling entirely (offline rehearsals, or set the game by hand in /admin).
DISABLE_MLB_POLLER=0

# --- Where guests follow along ----------------------------------------------
# Public URL of the scoreboard. Shown on the footer, the admin QR code and link previews.
# Leave blank and the scoreboard shows whatever host served it.
PUBLIC_URL=
# Extra browser origins allowed to call the API, comma-separated. PUBLIC_URL and localhost are always allowed.
CORS_ALLOW_ORIGINS=

# --- API runtime -------------------------------------------------------------
# Relative paths resolve from the repo root.
CHALLENGE_DB_PATH=./data/999.sqlite
SCOREBOARD_DIST_DIR=./apps/scoreboard-web/dist

# --- Kiosk -------------------------------------------------------------------
CHALLENGE_LOCAL_URL=http://127.0.0.1:8001/?mode=kiosk

# --- Frontend build (baked in at `pnpm build`) -------------------------------
# Same value as PUBLIC_URL. Used for the footer URL, QR code and share-card tags.
VITE_PUBLIC_URL=
# Footer line, e.g. "9·9·9 CHALLENGE — JULY 4, 2026"
VITE_EVENT_LABEL=9·9·9 CHALLENGE
# Only when the frontend is hosted apart from the API (e.g. Cloudflare Pages): the API's origin.
VITE_API_BASE=
