# Template: render and install with `sudo ./pi/scripts/install-services.sh nfc`.
[Unit]
Description=9-9-9 Challenge NFC Daemon
After=network-online.target 999-api.service
Wants=network-online.target
Requires=999-api.service

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/.venv/bin/python -m pi.nfc.main --api-url http://127.0.0.1:8001/api/tap --heartbeat-url http://127.0.0.1:8001/api/nfc/heartbeat
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
