# Template: render and install with `sudo ./pi/scripts/install-services.sh tunnel`.
# Needs infra/cloudflared/config.yml (copy it from config.example.yml first).
[Unit]
Description=9-9-9 Challenge Cloudflare Tunnel
After=network-online.target 999-api.service
Wants=network-online.target
Requires=999-api.service

[Service]
Type=simple
User=@APP_USER@
ExecStart=/usr/bin/cloudflared --config @APP_DIR@/infra/cloudflared/config.yml tunnel run
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
