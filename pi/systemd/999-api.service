# Template: render and install with `sudo ./pi/scripts/install-services.sh api`.
[Unit]
Description=9-9-9 Challenge API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APP_DIR@
Environment=CHALLENGE_DB_PATH=@APP_DIR@/data/999.sqlite
Environment=SCOREBOARD_DIST_DIR=@APP_DIR@/apps/scoreboard-web/dist
# MLB_TEAM_ID, MLB_GAME_DATE, PUBLIC_URL and friends come from the repo's .env.
EnvironmentFile=-@APP_DIR@/.env
ExecStart=@APP_DIR@/.venv/bin/uvicorn pi.api.main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
