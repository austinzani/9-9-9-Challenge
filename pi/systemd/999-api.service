[Unit]
Description=9-9-9 Challenge API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=austinzani
WorkingDirectory=/home/austinzani/9-9-9-Challenge
Environment=CHALLENGE_DB_PATH=/home/austinzani/9-9-9-Challenge/data/999.sqlite
Environment=MLB_TEAM_ID=113
Environment=MLB_GAME_DATE=2026-05-31
Environment=SCOREBOARD_DIST_DIR=/home/austinzani/9-9-9-Challenge/apps/scoreboard-web/dist
ExecStart=/home/austinzani/9-9-9-Challenge/.venv/bin/uvicorn pi.api.main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
